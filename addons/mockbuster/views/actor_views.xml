<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mockbuster_actor_tree" model="ir.ui.view">
        <field name="name">mockbuster.actor.tree</field>
        <field name="model">mockbuster.actor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="birth_date" />
                <field name="movie_count" />
            </tree>
        </field>
    </record>

    <record id="view_mockbuster_actor_form" model="ir.ui.view">
        <field name="name">mockbuster.actor.form</field>
        <field name="model">mockbuster.actor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Actor name" />
                        </h1>
                    </div>
                    <group>
                        <field name="birth_date" />
                    </group>
                    <notebook>
                        <page string="Filmography" name="movies">
                            <field name="movie_ids">
                                <tree>
                                    <field name="title" />
                                    <field name="year" />
                                    <field name="available_count" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mockbuster_actor" model="ir.actions.act_window">
        <field name="name">Actors</field>
        <field name="res_model">mockbuster.actor</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>