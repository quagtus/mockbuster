<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_rental_overdue" model="mail.template">
        <field name="name">Mockbuster: rental overdue</field>
        <field name="model_id" ref="model_mockbuster_rental" />
        <field name="subject">Overdue: {{ object.movie_id.title }} ({{ object.name }})</field>
        <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0;">
                <p>Hello <t t-out="object.partner_id.name or ''">Customer</t>,</p>
                <p> your rental <strong t-out="object.name or ''">RENT/2026/00001</strong> of <strong
                        t-out="object.movie_id.title or ''">Movie</strong> was due back on <t
                        t-out="format_date(object.date_due) or ''">01/01/2026</t>. </p>
                <p>Please return the copy (<t t-out="object.dvd_id.barcode or ''">GD-001</t>) as
                    soon as possible.</p>
                <p>Be kind, rewind.<br />Your Mockbuster team</p>
            </div>
        </field>
    </record>
</odoo>